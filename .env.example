# ==============================================================================
# SMART ACADEMIC TIMETABLE OPTIMIZER - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure for your deployment environment.
# ==============================================================================

# Environment: "development" or "production"
ENVIRONMENT=production

# Debug mode: false in production (disables Swagger docs and stack trace exposure)
DEBUG=false

# Application Secret Key (generate a random 32+ character key for production)
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Server Binding (Cloud hosts automatically supply $PORT)
HOST=0.0.0.0
PORT=8000

# Database Connection URL
# For SQLite (default, persistent file storage):
DATABASE_URL=sqlite:///timetable.db
# For PostgreSQL (Render / Railway / Supabase / AWS RDS):
# DATABASE_URL=postgresql://user:password@host:5432/timetables

# Allowed CORS Origins (comma-separated domains, or * for public)
# Example: https://timetable.your-institution.edu,https://admin.your-institution.edu
ALLOWED_ORIGINS=*

# Allowed Hosts (comma-separated hostnames or * for any)
# Example: timetable.your-institution.edu
ALLOWED_HOSTS=*
